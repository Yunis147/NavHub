[Unit]
Description=NavHub Web Backend and ROS 2 Bridge
After=network.target mongod.service ros2-odom.service
Wants=mongod.service

[Service]
Type=simple
User=yunis__147
WorkingDirectory=/home/yunis__147/NavHub
ExecStart=/home/yunis__147/NavHub/scripts/start_navhub.sh

Restart=on-failure
RestartSec=5

# Modern clean-up for the whole process tree spawned by the shell (rosbridge + node)
KillMode=control-group
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
